nums = [1,2,3,4,5,6,7]
#nums = [-1,-100,3,99]
#k = 2
k = 3
n = len(nums)
k %= n

def reverse(nums, left, right):
    while left < right:
        nums[left], nums[right] = nums[right], nums[left]
        left += 1
        right -= 1
    return nums
        
print(reverse(nums, 0, n-1))
print(reverse(nums, 0, k-1))
print(reverse(nums, k, n-1))
