class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        if len(s) % 2 == 1:  # odd length can't be balanced
            return False

        pairs = {')': '(', ']': '[', '}': '{'}
        stack = []
        for ch in s:
            if ch in pairs.values():  # opening bracket
                stack.append(ch)
            else:  # closing bracket
                if not stack or stack[-1] != pairs[ch]:
                    return False
                stack.pop()
        return not stack
